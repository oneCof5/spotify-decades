APP_NAME=Spotify Decades Plus
APP_DEBUG=false
PORT=8080
PLAYLIST_PREFIX=My
PLAYLIST_PUBLIC=false
DATABASE_PATH=/data/spotify_decades.db
LOG_PATH=/logs/app.log

SPOTIFY_REDIRECT_URI=http://localhost:8080/callback
MUSICBRAINZ_REDIRECT_URI=http://localhost:8080/musicbrainz/callback
MUSICBRAINZ_SCOPE=profile

# Prefer *_FILE with Docker secrets for sensitive values
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
FLASK_SECRET_KEY=
MUSICBRAINZ_CLIENT_ID=
MUSICBRAINZ_CLIENT_SECRET=
MUSICBRAINZ_USER_AGENT=spotify-decades-plus/1.0 (contact: you@example.com)

SPOTIFY_CLIENT_ID_FILE=
SPOTIFY_CLIENT_SECRET_FILE=
FLASK_SECRET_KEY_FILE=
MUSICBRAINZ_CLIENT_ID_FILE=
MUSICBRAINZ_CLIENT_SECRET_FILE=
MUSICBRAINZ_USER_AGENT_FILE=